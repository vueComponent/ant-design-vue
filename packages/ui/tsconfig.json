{
  "extends": "@ant-design-vue/typescript-config/tsconfig.vue.json",
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./assets/*"],
      "@ant-design-vue/ui": ["./src/index.ts"]
    }
  }
}
