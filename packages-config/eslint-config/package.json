{
  "name": "@ant-design-vue/eslint-config",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:typegen && tsdown",
    "build:typegen": "tsx scripts/typegen.ts",
    "inspector": "eslint-config-inspector --config eslint-inspector.config.ts"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
